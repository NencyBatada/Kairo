  "components": {
    "schemas": {
      "ApprovalSettings": {
        "required": [
          "briefApprovers",
          "assetApprovers",
          "launchApprovers",
          "budgetOwners",
          "budgetLimit",
          "currency"
        ],
        "type": "object",
        "properties": {
          "briefApprovers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "assetApprovers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "launchApprovers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "budgetOwners": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "budgetLimit": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "AuditEntryResponse": {
        "required": [
          "id",
          "occurredAt",
          "actorType",
          "actorId",
          "actorName",
          "action",
          "targetType",
          "targetId",
          "before",
          "after"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorType": {
            "type": "string"
          },
          "actorId": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorName": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
